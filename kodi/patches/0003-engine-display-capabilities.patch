+// The display of Kodi's window. A headless engine (KODI_ENGINE_MODE) renders into Surfaces of the
+// host application; its window is never attached and has no display, so the default display is
+// used instead.
+static CJNIDisplay getDisplay()
+{
+  CJNIWindow window = CXBMCApp::getWindow();
+  if (window)
+  {
+    CJNIView view = window.getDecorView();
+    if (view)
+    {
+      CJNIDisplay display = view.getDisplay();
+      if (display)
+        return display;
+    }
+  }
+
+  if (CXBMCApp::IsEngineMode())
+  {
+    CJNIWindowManager windowManager = CXBMCApp::getWindowManager();
+    if (windowManager)
+      return windowManager.getDefaultDisplay();
+  }
+
+  return CJNIDisplay(jni::jhobject());
+}

Headless engine mode: the GUI layer follows the size of its Surface.

With KODI_ENGINE_MODE set (by mpvlib-kodi's KodiEngine), Kodi renders into Surfaces owned by
the host application. Kodi normally keeps the GUI resolution of the first window it gets; here
CAndroidUtils reports the current Surface size and a Surface size change updates the desktop
resolution, so video and subtitles keep their aspect ratio when the host view is resized
(rotation, split screen, picture in picture). kodi_engine_capabilities() lets the engine detect
the patch.

diff --git a/xbmc/platform/android/activity/XBMCApp.cpp b/xbmc/platform/android/activity/XBMCApp.cpp
index 552d3ea..ff80fa1 100644
--- a/xbmc/platform/android/activity/XBMCApp.cpp
+++ b/xbmc/platform/android/activity/XBMCApp.cpp
@@ -1853,9 +1853,45 @@ void CXBMCApp::onDisplayRemoved(int displayId)
   android_printf("%s: ", __PRETTY_FUNCTION__);
 }
 
+// Lets a host application detect engine-mode support in libkodi.so.
+extern "C" __attribute__((visibility("default"))) int kodi_engine_capabilities()
+{
+  return 1; // bit 0: the GUI layer follows the size of its Surface
+}
+
+bool CXBMCApp::IsEngineMode()
+{
+  static const bool engine = getenv("KODI_ENGINE_MODE") != nullptr;
+  return engine;
+}
+
+void CXBMCApp::UpdateGuiResolutionCallback(void*)
+{
+  CWinSystemBase* winSystem = CServiceBroker::GetWinSystem();
+  if (!winSystem || !CXBMCApp::Get().m_window)
+    return;
+
+  // Re-probe: the desktop resolution is now the Surface size (see CAndroidUtils).
+  winSystem->UpdateResolutions();
+  CGraphicContext& gfx = winSystem->GetGfxContext();
+  gfx.SetVideoResolution(gfx.GetVideoResolution(), true);
+}
+
 void CXBMCApp::surfaceChanged(CJNISurfaceHolder holder, int format, int width, int height)
 {
-  android_printf("%s: ", __PRETTY_FUNCTION__);
+  android_printf("%s: %dx%d", __PRETTY_FUNCTION__, width, height);
+  if (!IsEngineMode() || width <= 0 || height <= 0)
+    return;
+
+  const bool resized = width != m_surfaceWidth || height != m_surfaceHeight;
+  m_surfaceWidth = width;
+  m_surfaceHeight = height;
+  if (resized && m_window && !m_firstrun && g_application.IsInitialized())
+  {
+    static KODI::MESSAGING::ThreadMessageCallback callback{UpdateGuiResolutionCallback, nullptr};
+    CServiceBroker::GetAppMessenger()->PostMsg(TMSG_CALLBACK, -1, -1,
+                                               static_cast<void*>(&callback));
+  }
 }
 
 void CXBMCApp::surfaceCreated(CJNISurfaceHolder holder)

+CVariant VideoSettingsToVariant(const CApplicationPlayer& appPlayer)
+{
+  const CVideoSettings vs = appPlayer.GetVideoSettings();
+
+  CVariant result(CVariant::VariantTypeObject);
+  result["brightness"] = vs.m_Brightness;
+  result["contrast"] = vs.m_Contrast;
+  result["gamma"] = vs.m_Gamma;
+  result["sharpness"] = vs.m_Sharpness;
+  result["noisereduction"] = vs.m_NoiseReduction;
+  result["postprocess"] = vs.m_PostProcess;
+  result["interlacemethod"] = static_cast<int>(vs.m_InterlaceMethod);
+  result["scalingmethod"] = static_cast<int>(vs.m_ScalingMethod);
+  result["viewmode"] = vs.m_ViewMode;
+  result["zoom"] = vs.m_CustomZoomAmount;
+  result["pixelratio"] = vs.m_CustomPixelRatio;
+  result["verticalshift"] = vs.m_CustomVerticalShift;
+  result["nonlinearstretch"] = vs.m_CustomNonLinStretch;
+  result["tonemapmethod"] = static_cast<int>(vs.m_ToneMapMethod);
+  result["tonemapparam"] = vs.m_ToneMapParam;
+  result["volumeamplification"] = vs.m_VolumeAmplification;
+  result["centermixlevel"] = vs.m_CenterMixLevel;
+
+  result["supports"] = CVariant(CVariant::VariantTypeObject);
+  for (const RenderFeature& feature : RenderFeatures)
+    result["supports"][feature.name] = appPlayer.Supports(feature.feature);
+
+  result["interlacemethods"] = CVariant(CVariant::VariantTypeArray);
+  for (EINTERLACEMETHOD method : InterlaceMethods)
+  {
+    if (appPlayer.Supports(method))
+      result["interlacemethods"].push_back(static_cast<int>(method));
+  }
+
+  result["scalingmethods"] = CVariant(CVariant::VariantTypeArray);
+  for (ESCALINGMETHOD method : ScalingMethods)
+  {
+    if (appPlayer.Supports(method))
+      result["scalingmethods"].push_back(static_cast<int>(method));
+  }
+
+  return result;
+}
+
+// Reads an optional setting into value. Fails if the setting is outside of [min, max].
+template<typename T>
+bool ParseSetting(const CVariant& setting, T min, T max, T& value, bool& changed)
+{
+  if (setting.isNull())
+    return true;
+
+  if constexpr (std::is_integral_v<T>)
+  {
+    const int64_t parsed = setting.asInteger();
+    if (parsed < min || parsed > max)
+      return false;
+    value = static_cast<T>(parsed);
+  }
+  else
+  {
+    const T parsed = static_cast<T>(setting.asDouble());
+    if (!(parsed >= min && parsed <= max))
+      return false;
+    value = parsed;
+  }
+
+  changed = true;
+  return true;
+}

+JSONRPC_STATUS CPlayerOperations::GetVideoSettings(const std::string& method,
+                                                   ITransportLayer* transport,
+                                                   IClient* client,
+                                                   const CVariant& parameterObject,
+                                                   CVariant& result)
+{
+  switch (GetPlayer(parameterObject["playerid"]))
+  {
+    case Video:
+    case Audio:
+    {
+      const auto& components = CServiceBroker::GetAppComponents();
+      const auto appPlayer = components.GetComponent<CApplicationPlayer>();
+      if (!appPlayer->HasPlayer())
+        return FailedToExecute;
+
+      result = VideoSettingsToVariant(*appPlayer);
+      return OK;
+    }
+
+    case Picture:
+    case None:
+    default:
+      return FailedToExecute;
+  }
+}
+
+JSONRPC_STATUS CPlayerOperations::SetVideoSettings(const std::string& method,
+                                                   ITransportLayer* transport,
+                                                   IClient* client,
+                                                   const CVariant& parameterObject,
+                                                   CVariant& result)
+{
+  switch (GetPlayer(parameterObject["playerid"]))
+  {
+    case Video:
+    case Audio:
+    {
+      auto& components = CServiceBroker::GetAppComponents();
+      const auto appPlayer = components.GetComponent<CApplicationPlayer>();
+      if (!appPlayer->HasPlayer())
+        return FailedToExecute;
+
+      // Everything is validated before anything is applied. The ranges are those of the video
+      // and audio settings dialogs; the JSON schema does not check integers given for numbers.
+      const CVariant& settings = parameterObject["settings"];
+      CVideoSettings vs = appPlayer->GetVideoSettings();
+      bool settingsChanged = false;
+      bool viewModeChanged = false;
+      bool amplificationChanged = false;
+      float amplification = vs.m_VolumeAmplification;
+
+      if (!ParseSetting(settings["brightness"], 0.0f, 100.0f, vs.m_Brightness, settingsChanged) ||
+          !ParseSetting(settings["contrast"], 0.0f, 100.0f, vs.m_Contrast, settingsChanged) ||
+          !ParseSetting(settings["gamma"], 0.0f, 100.0f, vs.m_Gamma, settingsChanged) ||
+          !ParseSetting(settings["sharpness"], -1.0f, 1.0f, vs.m_Sharpness, settingsChanged) ||
+          !ParseSetting(settings["noisereduction"], 0.0f, 1.0f, vs.m_NoiseReduction,
+                        settingsChanged) ||
+          !ParseSetting(settings["tonemapparam"], 0.1f, 5.0f, vs.m_ToneMapParam, settingsChanged) ||
+          !ParseSetting(settings["centermixlevel"], -10, 30, vs.m_CenterMixLevel,
+                        settingsChanged) ||
+          !ParseSetting(settings["zoom"], 0.5f, 2.0f, vs.m_CustomZoomAmount, viewModeChanged) ||
+          !ParseSetting(settings["pixelratio"], 0.5f, 2.0f, vs.m_CustomPixelRatio,
+                        viewModeChanged) ||
+          !ParseSetting(settings["verticalshift"], -2.0f, 2.0f, vs.m_CustomVerticalShift,
+                        viewModeChanged) ||
+          !ParseSetting(settings["volumeamplification"], VOLUME_DRC_MINIMUM * 0.01f,
+                        VOLUME_DRC_MAXIMUM * 0.01f, amplification, amplificationChanged))
+        return InvalidParams;
+
+      if (settings["postprocess"].isBoolean())
+      {
+        vs.m_PostProcess = settings["postprocess"].asBoolean();
+        settingsChanged = true;
+      }
+      if (settings["nonlinearstretch"].isBoolean())
+      {
+        vs.m_CustomNonLinStretch = settings["nonlinearstretch"].asBoolean();
+        viewModeChanged = true;
+      }
+
+      // As in the dialog, a custom zoom, pixel ratio, vertical shift or stretch selects the custom
+      // view mode, unless a view mode is given too.
+      if (viewModeChanged)
+        vs.m_ViewMode = ViewModeCustom;
+      if (!ParseSetting(settings["viewmode"], static_cast<int>(ViewModeNormal),
+                        static_cast<int>(ViewModeZoom110Width), vs.m_ViewMode, viewModeChanged))
+        return InvalidParams;
+
+      const CVariant& interlaceMethod = settings["interlacemethod"];
+      if (!interlaceMethod.isNull())
+      {
+        const auto method = std::find(std::begin(InterlaceMethods), std::end(InterlaceMethods),
+                                      interlaceMethod.asInteger());
+        if (method == std::end(InterlaceMethods) || !appPlayer->Supports(*method))
+          return InvalidParams;
+        vs.m_InterlaceMethod = *method;
+        settingsChanged = true;
+      }
+
+      const CVariant& scalingMethod = settings["scalingmethod"];
+      if (!scalingMethod.isNull())
+      {
+        const auto method = std::find(std::begin(ScalingMethods), std::end(ScalingMethods),
+                                      scalingMethod.asInteger());
+        if (method == std::end(ScalingMethods) || !appPlayer->Supports(*method))
+          return InvalidParams;
+        vs.m_ScalingMethod = *method;
+        settingsChanged = true;
+      }
+
+      int toneMapMethod = vs.m_ToneMapMethod;
+      if (!ParseSetting(settings["tonemapmethod"], static_cast<int>(VS_TONEMAPMETHOD_OFF),
+                        static_cast<int>(VS_TONEMAPMETHOD_MAX) - 1, toneMapMethod,
+                        settingsChanged))
+        return InvalidParams;
+      vs.m_ToneMapMethod = static_cast<ETONEMAPMETHOD>(toneMapMethod);
+
+      if (settingsChanged)
+        appPlayer->SetVideoSettings(vs);
+      if (viewModeChanged)
+        appPlayer->SetRenderViewMode(vs.m_ViewMode, vs.m_CustomZoomAmount, vs.m_CustomPixelRatio,
+                                     vs.m_CustomVerticalShift, vs.m_CustomNonLinStretch);
+      if (amplificationChanged)
+        appPlayer->SetDynamicRangeCompression(std::lround(amplification * 100));
+
+      result = VideoSettingsToVariant(*appPlayer);
+      return OK;
+    }
+
+    case Picture:
+    case None:
+    default:
+      return FailedToExecute;
+  }
+}
+
+JSONRPC_STATUS CPlayerOperations::GetChapters(const std::string& method,
+                                              ITransportLayer* transport,
+                                              IClient* client,
+                                              const CVariant& parameterObject,
+                                              CVariant& result)
+{
+  switch (GetPlayer(parameterObject["playerid"]))
+  {
+    case Video:
+    case Audio:
+    {
+      const auto& components = CServiceBroker::GetAppComponents();
+      const auto appPlayer = components.GetComponent<CApplicationPlayer>();
+
+      result = CVariant(CVariant::VariantTypeArray);
+      const int count = appPlayer->GetChapterCount();
+      for (int index = 1; index <= count; index++)
+      {
+        // Players report the start of a chapter in whole seconds.
+        const int64_t time = appPlayer->GetChapterPos(index);
+        if (time < 0)
+          continue;
+
+        std::string title;
+        appPlayer->GetChapterName(title, index);
+
+        CVariant chapter(CVariant::VariantTypeObject);
+        chapter["index"] = index;
+        chapter["title"] = title;
+        chapter["time"] = static_cast<double>(time);
+        result.push_back(std::move(chapter));
+      }
+      return OK;
+    }
+
+    case Picture:
+    case None:
+    default:
+      return FailedToExecute;
+  }
+}

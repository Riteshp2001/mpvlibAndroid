<?xml version="1.0" encoding="utf-8"?>
<!--
  Headless Kodi engine. Kodi runs in the host application's ":kodi" process, inside
  KodiEngineService, because libkodi.so owns its process: it keeps global state and calls exit(0)
  when it quits. Kodi shows no user interface; the host drives playback through KodiLib.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application>
        <service
            android:name="org.xbmc.kodi.engine.KodiEngineService"
            android:exported="false"
            android:process=":kodi" />
    </application>

</manifest>

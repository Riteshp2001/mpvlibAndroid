+dvdnav_status_t dvdnav_menu_available(dvdnav_t *this, DVDMenuID_t menu) {
+  dvdnav_status_t result = DVDNAV_STATUS_ERR;
+
+  if (menu != DVD_MENU_Root && menu != DVD_MENU_Title)
+    return result;
+
+  pthread_mutex_lock(&this->vm_lock);
+  if (this->vm->state.pgc) {
+    vm_t *try_vm = vm_new_copy(this->vm);
+    if (try_vm) {
+      if (vm_jump_menu(try_vm, menu) && !try_vm->stopped)
+        result = DVDNAV_STATUS_OK;
+      vm_free_copy(try_vm);
+    }
+  }
+  pthread_mutex_unlock(&this->vm_lock);
+  return result;
+}

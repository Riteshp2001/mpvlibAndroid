+/* Available in this build independently of the upstream version number. */
+#define DVDNAV_HAVE_TIME_SEARCH_FLOOR 1
+
+/* Seek within an open title PGC, in 90 kHz ticks, with PGC positioning enabled.
+ * On success the first delivered NAV, including angle/ILVU and hop processing,
+ * is at or before time. Payload starts with that VOBU. The caller must decode
+ * forward to its target. This does not promise a closed video GOP.
+ * NAV times are checked without changing the live VM. On error its navigation
+ * and read state are unchanged. Targets must be within the PGC duration.
+ * As with dvdnav_time_search(), seeking during a still frame is refused.
+ */
+DVDNAV_API dvdnav_status_t dvdnav_time_search_floor(dvdnav_t *self, uint64_t time);

+// Deliberately recognize only OpenJOC's dedicated single audio volume graph.
+// Other lavfi graphs and commands retain their normal upstream semantics.
+static bool is_openjoc_gain_graph(struct lavfi *c)
+{
+    const char *prefix = "volume@openjoc_gain=volume=";
+    if (c->direct_filter || !c->force_bidir || c->force_type != MP_FRAME_AUDIO ||
+        !c->graph_string || strncmp(c->graph_string, prefix, strlen(prefix)))
+        return false;
+    const char *start = c->graph_string + strlen(prefix);
+    char *end;
+    double value = strtod(start, &end);
+    return end != start && isfinite(value) && value >= 0.1 && value <= 10.0 &&
+           strcmp(end, ":precision=float") == 0;
+}
+
+static bool is_openjoc_gain_command(struct mp_filter_command *cmd)
+{
+    if (!cmd->target || !cmd->cmd || !cmd->arg ||
+        strcmp(cmd->target, "volume") || strcmp(cmd->cmd, "volume"))
+        return false;
+    char *end;
+    double value = strtod(cmd->arg, &end);
+    return end != cmd->arg && *end == '\0' && isfinite(value) &&
+           value >= 0.1 && value <= 10.0;
+}

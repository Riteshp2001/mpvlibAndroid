+static size_t read_preferred_file(void *data, unsigned char *buffer,
+                                  size_t offset, size_t length)
+{
+    PreferredFontFile *file = data;
+    if (!buffer)
+        return file->length;
+    if (offset >= (size_t) file->length || fseek(file->file, offset, SEEK_SET))
+        return 0;
+    return fread(buffer, 1, length, file->file);
+}
+
+static void retain_preferred_file(void *data)
+{
+    PreferredFontFile *file = data;
+    file->refs++;
+}
+
+static void release_preferred_file(void *data)
+{
+    PreferredFontFile *file = data;
+    if (--file->refs)
+        return;
+    if (file->file)
+        fclose(file->file);
+    free(file->path);
+    free(file->family);
+    free(file);
+}
+
+static ASS_FontStream preferred_stream(PreferredFontFile *file)
+{
+    return (ASS_FontStream) {
+        .func = read_preferred_file,
+        .priv = file,
+        .retain = retain_preferred_file,
+        .release = release_preferred_file,
+    };
+}
+
+static void clear_preferred_file(ASS_FontSelector *priv)
+{
+    if (priv->preferred_face)
+        FT_Done_Face(priv->preferred_face);
+    if (priv->preferred_file)
+        release_preferred_file(priv->preferred_file);
+    priv->preferred_face = NULL;
+    priv->preferred_file = NULL;
+}
+
+bool ass_fontselect_set_file(ASS_FontSelector *priv, const char *path, int index,
+                             const char *family)
+{
+    if (!path) {
+        clear_preferred_file(priv);
+        return true;
+    }
+    if (!family || !*family || index < 0 || index > UINT16_MAX)
+        return false;
+
+    PreferredFontFile *file = calloc(1, sizeof(*file));
+    if (!file)
+        return false;
+    file->refs = 1;
+    file->path = strdup(path);
+    file->family = strdup(family);
+    file->file = ass_open_file(path, FN_EXTERNAL);
+    if (!file->path || !file->family || !file->file ||
+            fseek(file->file, 0, SEEK_END) ||
+            (file->length = ftell(file->file)) <= 0)
+        goto fail;
+
+    ASS_FontStream stream = preferred_stream(file);
+    FT_Face face = ass_face_stream(priv->library, priv->ftlibrary, path,
+                                   &stream, index);
+    if (!face)
+        goto fail;
+    ass_charmap_magic(priv->library, face);
+
+    clear_preferred_file(priv);
+    file->index = index;
+    file->uid = priv->uid++;
+    priv->preferred_face = face;
+    priv->preferred_file = file;
+    return true;
+
+fail:
+    release_preferred_file(file);
+    return false;
+}

+                      const char *family)
+{
+    if (!priv->fontselect ||
+            !ass_fontselect_set_file(priv->fontselect, path, index, family))
+        return 0;
+    ass_reconfigure(priv);
+    ass_cache_empty(priv->cache.face_size_metrics_cache);

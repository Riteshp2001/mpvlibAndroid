+struct font_cache_job {
+    char *config;
+    int font_provider;
+};
+
+static MP_THREAD_VOID font_cache_thread(void *arg)
+{
+    struct font_cache_job *job = arg;
+    mp_thread_set_name("font-cache");
+
+    // A throwaway renderer: setting up its fonts builds the fontconfig cache.
+    ASS_Library *library = ass_library_init();
+    if (library) {
+        ASS_Renderer *renderer = ass_renderer_init(library);
+        if (renderer) {
+            ass_set_fonts(renderer, NULL, NULL, job->font_provider, job->config, 1);
+            ass_renderer_done(renderer);
+        }
+        ass_library_done(library);
+    }
+
+    talloc_free(job);
+    MP_THREAD_RETURN();
+}
+
+// Every subtitle track and the OSD set up fonts synchronously. Without a font
+// cache that scans all system fonts on the playback thread and starves audio,
+// so build the cache in the background once a fonts.conf configures it.
+void mp_ass_warm_font_cache(struct mpv_global *global,
+                            struct osd_style_opts *opts)
+{
+    if (opts->font_provider == 1)
+        return;
+
+    struct font_cache_job *job = talloc_zero(NULL, struct font_cache_job);
+    job->config = mp_find_config_file(job, global, "fonts.conf");
+    job->font_provider = opts->font_provider == 2 ? ASS_FONTPROVIDER_FONTCONFIG
+                                                  : ASS_FONTPROVIDER_AUTODETECT;
+    if (!job->config) {
+        talloc_free(job);
+        return;
+    }
+
+    mp_thread thread;
+    if (mp_thread_create(&thread, font_cache_thread, job)) {
+        talloc_free(job);
+        return;
+    }
+    mp_thread_detach(thread);
+}

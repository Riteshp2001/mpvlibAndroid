diff --git a/meson.build b/meson.build
index 6b828ba486..cb27e3cdcd 100644
--- a/meson.build
+++ b/meson.build
@@ -476,7 +476,11 @@ features += {'ppoll': cc.has_function('ppoll', args: '-D_GNU_SOURCE',
                                       prefix: '#include <poll.h>')}
 features += {'memrchr': cc.has_function('memrchr', args: '-D_GNU_SOURCE',
                                         prefix: '#include <string.h>')}
-features += {'clone': cc.has_header_symbol('sched.h', 'clone', args: '-D_GNU_SOURCE')}
+# Bionic resets fdsan ownership metadata in fork(), but not in raw clone().
+# Force Android through mpv's fork-based subprocess path so a child cannot
+# corrupt the parent process's file-descriptor ownership table.
+features += {'clone': host_machine.system() != 'android' and
+                      cc.has_header_symbol('sched.h', 'clone', args: '-D_GNU_SOURCE')}
 features += {'rfork': cc.has_header_symbol('unistd.h', 'RFSPAWN') and
                       cc.has_function('rfork_thread', prefix: '#include <unistd.h>')}
 

new file mode 100644
index 0000000..bc2203f
--- /dev/null
+++ b/crates/openjoc-capi/tests/shared_hrtf.rs
@@ -0,0 +1,184 @@
+#![allow(unsafe_code)]
+
+use openjoc_capi::*;
+use std::{fs, mem::MaybeUninit, path::Path, ptr, slice};
+
+fn assert_progress(status: openjoc_status) {
+    assert!(
+        matches!(
+            status,
+            openjoc_status::OPENJOC_STATUS_OK
+                | openjoc_status::OPENJOC_STATUS_FRAME_AVAILABLE
+                | openjoc_status::OPENJOC_STATUS_NEED_MORE_INPUT
+        ),
+        "unexpected decoder progress status: {status:?}"
+    );
+}
+
+fn decoder_config(preset: u32, pull_samples: u32) -> openjoc_decoder_config {
+    let mut output = MaybeUninit::uninit();
+    assert_eq!(
+        openjoc_decoder_config_init_v1_7(output.as_mut_ptr()),
+        openjoc_status::OPENJOC_STATUS_OK
+    );
+    let mut output = unsafe { output.assume_init() };
+    output.render_mode = openjoc_render_mode::OPENJOC_RENDER_BINAURAL as u32;
+    output.hrtf_preset = preset;
+    output.listener_orientation_pull_samples = pull_samples;
+    output
+}
+
+fn collect<T>(
+    decoder: *mut T,
+    receive: extern "C" fn(*mut T, *mut openjoc_pcm_frame) -> openjoc_status,
+) -> Vec<u32> {
+    let mut result = Vec::new();
+    for _ in 0..256 {
+        let mut frame = MaybeUninit::uninit();
+        assert_eq!(
+            openjoc_pcm_frame_init(frame.as_mut_ptr()),
+            openjoc_status::OPENJOC_STATUS_OK
+        );
+        match receive(decoder, frame.as_mut_ptr()) {
+            openjoc_status::OPENJOC_STATUS_FRAME_AVAILABLE => {
+                let frame = unsafe { frame.assume_init() };
+                assert_eq!(
+                    (frame.sample_format, frame.sample_rate, frame.channel_count),
+                    (1, 48_000, 2)
+                );
+                let sample_count = frame.sample_count * frame.channel_count as usize;
+                assert_eq!(frame.data_len, sample_count * size_of::<f32>());
+                let samples = unsafe { slice::from_raw_parts(frame.data, sample_count) };
+                assert!(samples.iter().all(|sample| sample.is_finite()));
+                result.extend(samples.iter().map(|sample| sample.to_bits()));
+            }
+            openjoc_status::OPENJOC_STATUS_NEED_MORE_INPUT
+            | openjoc_status::OPENJOC_STATUS_END_OF_STREAM => return result,
+            other => panic!("unexpected receive status: {other:?}"),
+        }
+    }
+    panic!("decoder exceeded the fixture's bounded frame count");
+}
+
+#[test]
+fn shared_banks_preserve_pcm_ownership_reset_and_pull_rendering() {
+    let banks = [
+        (0, "sadie-ii-d1-ku100.ojhrtf"),
+        (1, "sadie-ii-d2-kemar.ojhrtf"),
+    ];
+    let root = Path::new(env!("CARGO_MANIFEST_DIR")).parent().unwrap();
+    let fixture = include_bytes!("../../openjoc-wasm/testdata/joc.lifecycle.ec3");
+    for (preset, name) in banks {
+        for pull_samples in [0, 128] {
+            let config = decoder_config(preset, pull_samples);
+            let bank = fs::read(root.join("openjoc-sofa/assets").join(name)).unwrap();
+            let mut raw = ptr::null_mut();
+            let mut stream = ptr::null_mut();
+            assert_eq!(
+                openjoc_decoder_create_with_hrtf_asset(
+                    &config,
+                    bank.as_ptr(),
+                    bank.len(),
+                    &mut raw
+                ),
+                openjoc_status::OPENJOC_STATUS_OK
+            );
+            assert_eq!(
+                openjoc_stream_decoder_create_with_hrtf_asset(
+                    &config,
+                    bank.as_ptr(),
+                    bank.len(),
+                    &mut stream
+                ),
+                openjoc_status::OPENJOC_STATUS_OK
+            );
+            drop(bank);
+            for _ in 0..2 {
+                let mut expected = Vec::new();
+                let mut actual = Vec::new();
+                for (index, packet) in fixture.chunks_exact(4096).take(4).enumerate() {
+                    let pts = index as i64 * 1536;
+                    assert_progress(openjoc_decoder_send_packet(
+                        raw,
+                        packet.as_ptr(),
+                        packet.len(),
+                        pts,
+                        0,
+                    ));
+                    expected.extend(collect(raw, openjoc_decoder_receive_frame));
+                    for (fragment_index, fragment) in packet.chunks(1000).enumerate() {
+                        assert_progress(openjoc_stream_decoder_send_chunk(
+                            stream,
+                            fragment.as_ptr(),
+                            fragment.len(),
+                            if fragment_index == 0 {
+                                pts
+                            } else {
+                                OPENJOC_NO_PTS
+                            },
+                            0,
+                        ));
+                        actual.extend(collect(stream, openjoc_stream_decoder_receive_frame));
+                    }
+                }
+                assert_progress(openjoc_decoder_drain(raw));
+                assert_progress(openjoc_stream_decoder_drain(stream));
+                expected.extend(collect(raw, openjoc_decoder_receive_frame));
+                actual.extend(collect(stream, openjoc_stream_decoder_receive_frame));
+                assert!(!expected.is_empty());
+                assert!(expected.iter().any(|bits| f32::from_bits(*bits) != 0.0));
+                assert_eq!(
+                    actual, expected,
+                    "PCM changed for {name}, pull={pull_samples}"
+                );
+                assert_eq!(
+                    openjoc_decoder_reset(raw),
+                    openjoc_status::OPENJOC_STATUS_OK
+                );
+                assert_eq!(
+                    openjoc_stream_decoder_flush(stream),
+                    openjoc_status::OPENJOC_STATUS_OK
+                );
+            }
+            openjoc_decoder_destroy(raw);
+            openjoc_stream_decoder_destroy(stream);
+        }
+    }
+}
+
+#[test]
+fn shared_banks_fail_explicitly_when_missing_corrupt_or_mismatched() {
+    let root = Path::new(env!("CARGO_MANIFEST_DIR")).parent().unwrap();
+    let mut bank = fs::read(root.join("openjoc-sofa/assets/sadie-ii-d1-ku100.ojhrtf")).unwrap();
+    let config = decoder_config(0, 0);
+    let mut decoder = ptr::null_mut();
+    assert_ne!(
+        openjoc_stream_decoder_create(&config, &mut decoder),
+        openjoc_status::OPENJOC_STATUS_OK
+    );
+    assert_eq!(
+        openjoc_stream_decoder_create_with_hrtf_asset(&config, ptr::null(), 0, &mut decoder),
+        openjoc_status::OPENJOC_STATUS_INVALID_ARGUMENT
+    );
+    let mismatched = decoder_config(1, 0);
+    assert_ne!(
+        openjoc_stream_decoder_create_with_hrtf_asset(
+            &mismatched,
+            bank.as_ptr(),
+            bank.len(),
+            &mut decoder
+        ),
+        openjoc_status::OPENJOC_STATUS_OK
+    );
+    bank[0] ^= 1;
+    assert_ne!(
+        openjoc_stream_decoder_create_with_hrtf_asset(
+            &config,
+            bank.as_ptr(),
+            bank.len(),
+            &mut decoder
+        ),
+        openjoc_status::OPENJOC_STATUS_OK
+    );
+    assert!(decoder.is_null());
+}

+
+dvdnav_status_t dvdnav_get_current_block_position(
+    dvdnav_t *this, dvdnav_block_position_t *position) {
+  dvdnav_block_position_t result;
+  int64_t sector;
+  if (!this || !position)
+    return DVDNAV_STATUS_ERR;
+  pthread_mutex_lock(&this->vm_lock);
+  sector = (int64_t)this->vobu.vobu_start + this->vobu.blockN;
+  if (!this->file || sector < 0 || sector > INT32_MAX)
+    goto fail;
+  result.title_set = this->position_current.vts;
+  switch (this->position_current.domain) {
+    case DVD_DOMAIN_FirstPlay:
+    case DVD_DOMAIN_VMGM:
+      result.title_set = 0;
+      result.domain = DVD_READ_MENU_VOBS;
+      break;
+    case DVD_DOMAIN_VTSMenu:
+      result.domain = DVD_READ_MENU_VOBS;
+      break;
+    case DVD_DOMAIN_VTSTitle:
+      result.domain = DVD_READ_TITLE_VOBS;
+      break;
+    default:
+      goto fail;
+  }
+  result.sector = (uint32_t)sector;
+  *position = result;
+  pthread_mutex_unlock(&this->vm_lock);
+  return DVDNAV_STATUS_OK;
+fail:
+  pthread_mutex_unlock(&this->vm_lock);
+  return DVDNAV_STATUS_ERR;
+}
+
+dvd_file_t *dvdnav_open_block_reader(
+    dvdnav_t *this, const dvdnav_block_position_t *position) {
+  dvd_file_t *file;
+  if (!this || !position || position->title_set < 0 || position->title_set > 99 ||
+      position->sector > INT32_MAX ||
+      (position->domain != DVD_READ_MENU_VOBS && position->domain != DVD_READ_TITLE_VOBS) ||
+      (position->domain == DVD_READ_TITLE_VOBS && !position->title_set))
+    return NULL;
+  pthread_mutex_lock(&this->vm_lock);
+  file = this->vm && this->vm->dvd
+      ? DVDOpenFile(this->vm->dvd, position->title_set, position->domain) : NULL;
+  pthread_mutex_unlock(&this->vm_lock);
+  return file;
 }
 

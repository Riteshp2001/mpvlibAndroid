 /**
  * Open an unencrypted file on a DVD image file.
  */
+/* Select by volume recognition, never by a failed UDF file lookup. */
+static int DVDImageFileSystem( dvd_reader_t *ctx )
+{
+  if( !ctx->rd->image_filesystem ) {
+    int result = DVDISO9660Detect( ctx, &ctx->rd->iso9660 );
+    ctx->rd->image_filesystem = result < 0 ? -1 : result ? 2 : 1;
+  }
+  return ctx->rd->image_filesystem;
+}
+
+/* Existing callers need the initial physical LBA for CSS key selection, or
+ * the size of DVD files (each IFO/BUP/VOB part fits in uint32_t). File data
+ * itself must always be read through the complete extent map. */
+static uint32_t DVDImageFindFile( dvd_reader_t *ctx, const char *filename, uint32_t *size )
+{
+  *size = 0;
+  int filesystem = DVDImageFileSystem( ctx );
+  if( filesystem < 0 ) return 0;
+  if( filesystem == 1 ) return UDFFindFile( ctx, filename, size );
+  dvd_iso9660_file_t file;
+  int found = DVDISO9660FindFile( ctx, ctx->rd->iso9660, filename, &file );
+  uint32_t start = 0;
+  if( found == 1 && file.count && file.size <= UINT32_MAX ) {
+    start = file.extents[0].lba;
+    *size = (uint32_t)file.size;
+  }
+  DVDISO9660Clear( &file );
+  return start;
+}
+
+static dvd_file_t *DVDOpenFileISO( dvd_reader_t *ctx, const char *filename,
+                                  int do_cache )
+{
+  dvd_file_t *file = calloc( 1, sizeof(*file) );
+  if( !file ) return NULL;
+  if( DVDISO9660FindFile( ctx, ctx->rd->iso9660, filename, &file->iso_file ) != 1 ||
+      file->iso_file.size % DVD_VIDEO_LB_LEN ||
+      file->iso_file.size / DVD_VIDEO_LB_LEN > INT_MAX ) {
+    DVDISO9660Clear( &file->iso_file );
+    free( file );
+    return NULL;
+  }
+  file->ctx = ctx;
+  file->lb_start = file->iso_file.count ? file->iso_file.extents[0].lba : 0;
+  file->filesize = (ssize_t)(file->iso_file.size / DVD_VIDEO_LB_LEN);
+  if( do_cache && file->filesize > 0 && file->filesize < 64 ) {
+    file->cache = malloc( (size_t)file->iso_file.size );
+    if( file->cache && DVDISO9660ReadBlocks( ctx, &file->iso_file, 0,
+        (size_t)file->filesize, file->cache, DVDINPUT_NOFLAGS ) != file->filesize ) {
+      /* A source read failure is not an instruction to retry uncached. */
+      free( file->cache );
+      DVDISO9660Clear( &file->iso_file );
+      free( file );
+      return NULL;
+    }
+  }
+  return file;
+}
+
+static dvd_file_t *DVDOpenVOBISO( dvd_reader_t *ctx, int title, int menu )
+{
+  char filename[MAX_UDF_FILE_NAME_LEN];
+  dvd_file_t *file = NULL;
+  for( int part = menu ? 0 : 1; part <= (menu ? 0 : 9); part++ ) {
+    if( title == 0 )
+      sprintf( filename, "/%s_TS/%s_TS.VOB", DVD_TYPE_STRING(ctx->dvd_type),
+               DVD_TYPE_STRING(ctx->dvd_type) );
+    else
+      sprintf( filename, "/%s_TS/%cTS_%02d_%d.%cOB", DVD_TYPE_STRING(ctx->dvd_type),
+               STREAM_TYPE_STRING(ctx->dvd_type), title, part,
+               STREAM_TYPE_STRING(ctx->dvd_type) );
+    dvd_iso9660_file_t section;
+    int found = DVDISO9660FindFile( ctx, ctx->rd->iso9660, filename, &section );
+    if( found < 0 || (found && (section.size % DVD_VIDEO_LB_LEN ||
+        section.size / DVD_VIDEO_LB_LEN > INT_MAX)) ) {
+      DVDISO9660Clear( &section );
+      goto fail;
+    }
+    if( !found ) break;
+    if( !file ) {
+      file = calloc( 1, sizeof(*file) );
+      if( !file ) {
+        DVDISO9660Clear( &section );
+        return NULL;
+      }
+      file->ctx = ctx;
+      if( ctx->dvd_type == DVD_V ) file->css_title = title << 1 | menu;
+    }
+    int appended = DVDISO9660Append( &file->iso_file, &section );
+    DVDISO9660Clear( &section );
+    if( appended < 0 || file->iso_file.size / DVD_VIDEO_LB_LEN > INT_MAX )
+      goto fail;
+    if( title == 0 ) break;
+  }
+  if( file ) {
+    file->filesize = (ssize_t)(file->iso_file.size / DVD_VIDEO_LB_LEN);
+    file->lb_start = file->iso_file.count ? file->iso_file.extents[0].lba : 0;
+    if( ctx->dvd_type == DVD_V && ctx->rd->css_state == 1 ) {
+      initAllCSSKeys( ctx );
+      ctx->rd->css_state = 2;
+    }
+  }
+  return file;
+fail:
+  if( file ) {
+    DVDISO9660Clear( &file->iso_file );
+    free( file );
+  }
+  return NULL;
+}
+
+static int DVDFileStatISO( dvd_reader_t *ctx, int title, int menu, dvd_stat_t *statbuf )
+{
+  char filename[MAX_UDF_FILE_NAME_LEN];
+  memset( statbuf, 0, sizeof(*statbuf) );
+  for( int part = menu ? 0 : 1; part <= (menu ? 0 : 9); part++ ) {
+    if( title == 0 )
+      sprintf( filename, "/%s_TS/%s_TS.VOB", DVD_TYPE_STRING(ctx->dvd_type),
+               DVD_TYPE_STRING(ctx->dvd_type) );
+    else
+      sprintf( filename, "/%s_TS/%cTS_%02d_%d.%cOB", DVD_TYPE_STRING(ctx->dvd_type),
+               STREAM_TYPE_STRING(ctx->dvd_type), title, part,
+               STREAM_TYPE_STRING(ctx->dvd_type) );
+    dvd_iso9660_file_t section;
+    int found = DVDISO9660FindFile( ctx, ctx->rd->iso9660, filename, &section );
+    if( found != 1 ) return found < 0 || !statbuf->nr_parts ? -1 : 0;
+    uint64_t size = section.size;
+    DVDISO9660Clear( &section );
+    /* dvd_stat_t uses off_t, which can be 32 bits on some hosts. */
+    off_t total = (off_t)((uint64_t)statbuf->size + size);
+    if( total < 0 || (uint64_t)total != (uint64_t)statbuf->size + size ) return -1;
+    statbuf->parts_size[statbuf->nr_parts++] = (off_t)size;
+    statbuf->size = total;
+    if( title == 0 ) break;
+  }
+  return 0;
+}

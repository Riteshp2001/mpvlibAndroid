--- /dev/null
+++ b/src/dvd_iso9660.h
@@ -0,0 +1,41 @@
+/*
+ * This file is part of libdvdread.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef LIBDVDREAD_DVD_ISO9660_H
+#define LIBDVDREAD_DVD_ISO9660_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include "dvdread/dvd_reader.h"
+
+typedef struct {
+  uint32_t lba;
+  uint32_t blocks;
+} dvd_iso9660_extent_t;
+
+typedef struct {
+  dvd_iso9660_extent_t *extents;
+  size_t count, capacity;
+  uint64_t size;
+} dvd_iso9660_file_t;
+
+typedef struct {
+  uint32_t volume_blocks, primary_lba;
+  uint32_t root_lba, root_size;
+} dvd_iso9660_t;
+
+/* 1: ISO9660, 0: UDF or no ISO9660, -1: malformed/unsupported image or I/O error.
+ * UDF recognition always takes precedence over the ISO9660 primary namespace. */
+int DVDISO9660Detect(dvd_reader_t *, dvd_iso9660_t **);
+
+/* 1: found, 0: absent, -1: malformed/unsupported file or I/O error.
+ * The caller owns the returned extent array, including after appending files. */
+int DVDISO9660FindFile(dvd_reader_t *, const dvd_iso9660_t *, const char *,
+                     dvd_iso9660_file_t *);
+int DVDISO9660Append(dvd_iso9660_file_t *, const dvd_iso9660_file_t *);
+void DVDISO9660Clear(dvd_iso9660_file_t *);
+int DVDISO9660ReadBlocks(dvd_reader_t *, const dvd_iso9660_file_t *, uint32_t,
+                        size_t, unsigned char *, int);
+
+#endif

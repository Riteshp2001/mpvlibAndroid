diff --git a/src/dvd_iso9660.c b/src/dvd_iso9660.c
--- /dev/null
+++ b/src/dvd_iso9660.c
@@ -0,0 +1,299 @@
+/*
+ * ISO9660 primary-volume file lookup and file-section mapping (ECMA-119).
+ * This file is part of libdvdread.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "config.h"
+#include <limits.h>
+#include <stdlib.h>
+#include <string.h>
+#include "dvd_iso9660.h"
+#include "dvdread_internal.h"
+
+#define SECTOR DVD_VIDEO_LB_LEN
+#define MAX_VOLUME_DESCRIPTORS 256
+
+typedef struct {
+  uint32_t lba, size;
+  unsigned flags;
+  const unsigned char *name;
+  size_t name_length;
+} iso_record_t;
+
+static int iso_both16(const unsigned char *p, uint16_t *v)
+{
+  *v = (uint16_t)(p[0] | p[1] << 8);
+  return *v == (uint16_t)(p[2] << 8 | p[3]);
+}
+
+static int iso_both32(const unsigned char *p, uint32_t *v)
+{
+  *v = (uint32_t)p[0] | (uint32_t)p[1] << 8 |
+       (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+  return *v == ((uint32_t)p[4] << 24 | (uint32_t)p[5] << 16 |
+                (uint32_t)p[6] << 8 | p[7]);
+}
+
+static int iso_record(const unsigned char *p, size_t available,
+                      uint32_t volume_blocks, iso_record_t *record)
+{
+  uint16_t volume;
+  uint32_t lba, size;
+  if (available < 34 || p[0] < 34 || p[0] > available ||
+      p[32] == 0 || p[32] > p[0] - 33 ||
+      !iso_both32(p + 2, &lba) || !iso_both32(p + 10, &size) ||
+      !iso_both16(p + 28, &volume) || volume != 1 || p[26] || p[27])
+    return -1;
+  /* Extended-attribute blocks precede file data. ISO file-unit interleaving
+   * (unlike DVD ILVU data inside a VOB) is not supported. */
+  if (lba > volume_blocks || p[1] > volume_blocks - lba)
+    return -1;
+  lba += p[1];
+  if ((uint64_t)size > (uint64_t)(volume_blocks - lba) * SECTOR)
+    return -1;
+  record->lba = lba;
+  record->size = size;
+  record->flags = p[25];
+  record->name = p + 33;
+  record->name_length = p[32];
+  if ((record->flags & 0x80) &&
+      ((record->flags & 2) || !size || size % SECTOR))
+    return -1;
+  return 0;
+}
+
+int DVDISO9660Detect(dvd_reader_t *ctx, dvd_iso9660_t **result)
+{
+  unsigned char sector[SECTOR], primary[SECTOR];
+  int found = 0, terminated = 0, saw_iso = 0, invalid_version = 0;
+  uint32_t volume_blocks, primary_lba = 0;
+  uint16_t block_size, volumes, volume;
+  iso_record_t root;
+  *result = NULL;
+  unsigned i;
+  for (i = 0; i < MAX_VOLUME_DESCRIPTORS; i++) {
+    int read = InternalUDFReadBlocksRaw(ctx, 16 + i, 1, sector, 0);
+    if (read != 1)
+      return -1;
+    if (!memcmp(sector + 1, "NSR02", 5) || !memcmp(sector + 1, "NSR03", 5))
+      return 0;
+    if (!memcmp(sector + 1, "BEA01", 5) || !memcmp(sector + 1, "TEA01", 5) ||
+        !memcmp(sector + 1, "BOOT2", 5) || !memcmp(sector + 1, "CDW02", 5))
+      continue;
+    if (memcmp(sector + 1, "CD001", 5))
+      break;
+    saw_iso = 1;
+    if (sector[0] == 1 || sector[0] == 255)
+      invalid_version |= sector[6] != 1;
+    if (sector[0] == 1 && !found) {
+      memcpy(primary, sector, SECTOR);
+      primary_lba = 16 + i;
+      found = 1;
+    }
+    if (sector[0] == 255)
+      terminated = 1;
+  }
+  if (i == MAX_VOLUME_DESCRIPTORS)
+    return -1;
+  if (!saw_iso)
+    return 0;
+  if (!found || !terminated || invalid_version ||
+      !iso_both32(primary + 80, &volume_blocks) || volume_blocks < 18 ||
+      volume_blocks > INT_MAX || !iso_both16(primary + 128, &block_size) ||
+      block_size != SECTOR || !iso_both16(primary + 120, &volumes) || volumes != 1 ||
+      !iso_both16(primary + 124, &volume) || volume != 1 ||
+      iso_record(primary + 156, SECTOR - 156, volume_blocks, &root) < 0 ||
+      !(root.flags & 2) || root.name_length != 1 || root.name[0] != 0)
+    return -1;
+  dvd_iso9660_t *fs = malloc(sizeof(*fs));
+  if (!fs)
+    return -1;
+  fs->volume_blocks = volume_blocks;
+  fs->primary_lba = primary_lba;
+  fs->root_lba = root.lba;
+  fs->root_size = root.size;
+  *result = fs;
+  return 1;
+}
+
+void DVDISO9660Clear(dvd_iso9660_file_t *file)
+{
+  free(file->extents);
+  memset(file, 0, sizeof(*file));
+}
+
+static int iso_append_extent(dvd_iso9660_file_t *file, uint32_t lba, uint32_t size)
+{
+  uint32_t blocks = size / SECTOR + (size % SECTOR != 0);
+  if (file->size % SECTOR || size > UINT64_MAX - file->size)
+    return -1;
+  if (file->count == file->capacity) {
+    size_t capacity = file->capacity ? file->capacity * 2 : 4;
+    if (capacity < file->capacity || capacity > SIZE_MAX / sizeof(*file->extents))
+      return -1;
+    void *extents = realloc(file->extents, capacity * sizeof(*file->extents));
+    if (!extents)
+      return -1;
+    file->extents = extents;
+    file->capacity = capacity;
+  }
+  file->extents[file->count++] = (dvd_iso9660_extent_t){lba, blocks};
+  file->size += size;
+  return 0;
+}
+
+int DVDISO9660Append(dvd_iso9660_file_t *file, const dvd_iso9660_file_t *part)
+{
+  if (file->size % SECTOR || part->size > UINT64_MAX - file->size ||
+      part->count > SIZE_MAX / sizeof(*file->extents) - file->count)
+    return -1;
+  size_t count = file->count + part->count;
+  if (count > file->capacity) {
+    void *extents = realloc(file->extents, count * sizeof(*file->extents));
+    if (!extents)
+      return -1;
+    file->extents = extents;
+    file->capacity = count;
+  }
+  if (part->count)
+    memcpy(file->extents + file->count, part->extents,
+           part->count * sizeof(*file->extents));
+  file->count = count;
+  file->size += part->size;
+  return 0;
+}
+
+static unsigned iso_upper(unsigned c)
+{
+  return c >= 'a' && c <= 'z' ? c - 'a' + 'A' : c;
+}
+
+static int iso_name_matches(const iso_record_t *record, const char *name, size_t length)
+{
+  size_t n = record->name_length;
+  /* DVD callers omit the ISO file version. Do not prefix-match names. */
+  for (size_t i = 0; i < n; i++) {
+    if (record->name[i] == ';') {
+      if (i + 1 == n)
+        return 0;
+      for (size_t j = i + 1; j < n; j++)
+        if (record->name[j] < '0' || record->name[j] > '9')
+          return 0;
+      n = i;
+      break;
+    }
+  }
+  if (n != length)
+    return 0;
+  for (size_t i = 0; i < n; i++)
+    if (iso_upper(record->name[i]) != iso_upper((unsigned char)name[i]))
+      return 0;
+  return 1;
+}
+
+static int iso_scan_directory(dvd_reader_t *ctx, const dvd_iso9660_t *fs,
+                              uint32_t lba, uint32_t size, const char *name,
+                              size_t length, int directory, iso_record_t *selected,
+                              dvd_iso9660_file_t *file)
+{
+  unsigned char sector[SECTOR], previous_name[255];
+  size_t previous_length = 0;
+  int continuation = 0, found = 0;
+  unsigned previous_flags = 0;
+  for (uint64_t offset = 0; offset < size; offset += SECTOR) {
+    size_t limit = size - offset < SECTOR ? (size_t)(size - offset) : SECTOR;
+    if (InternalUDFReadBlocksRaw(ctx, lba + (uint32_t)(offset / SECTOR),
+                                 1, sector, 0) != 1)
+      return -1;
+    for (size_t pos = 0; pos < limit;) {
+      iso_record_t entry;
+      if (!sector[pos])
+        break; /* Directory padding extends to the next logical sector. */
+      if (iso_record(sector + pos, limit - pos, fs->volume_blocks, &entry) < 0)
+        return -1;
+      pos += sector[pos];
+      if (continuation &&
+          (entry.name_length != previous_length ||
+           memcmp(entry.name, previous_name, previous_length) ||
+           (entry.flags & ~0x80u) != previous_flags))
+        return -1;
+      int matches = !(entry.flags & 4) && iso_name_matches(&entry, name, length);
+      if (matches) {
+        if (!!(entry.flags & 2) != directory || (found && !continuation))
+          return -1;
+        if (!found)
+          *selected = entry;
+        if (iso_append_extent(file, entry.lba, entry.size) < 0)
+          return -1;
+        found = 1;
+      }
+      continuation = (entry.flags & 0x80) != 0;
+      if (continuation) {
+        previous_length = entry.name_length;
+        memcpy(previous_name, entry.name, previous_length);
+        previous_flags = entry.flags & ~0x80u;
+      }
+    }
+  }
+  return continuation ? -1 : found;
+}
+
+int DVDISO9660FindFile(dvd_reader_t *ctx, const dvd_iso9660_t *fs,
+                     const char *path, dvd_iso9660_file_t *file)
+{
+  uint32_t lba = fs->root_lba, size = fs->root_size;
+  memset(file, 0, sizeof(*file));
+  if (*path != '/')
+    return -1;
+  path++;
+  while (*path) {
+    iso_record_t entry;
+    const char *end = strchr(path, '/');
+    size_t length = end ? (size_t)(end - path) : strlen(path);
+    if (!length || length > 255 || (end && !end[1]))
+      return -1;
+    int result = iso_scan_directory(ctx, fs, lba, size, path, length, end != NULL,
+                                    &entry, file);
+    if (result != 1) {
+      DVDISO9660Clear(file);
+      return result;
+    }
+    if (!end)
+      return 1;
+    lba = entry.lba;
+    size = entry.size;
+    DVDISO9660Clear(file);
+    path = end + 1;
+  }
+  return -1;
+}
+
+int DVDISO9660ReadBlocks(dvd_reader_t *ctx, const dvd_iso9660_file_t *file,
+                        uint32_t offset, size_t count, unsigned char *data, int flags)
+{
+  uint64_t blocks = file->size / SECTOR + (file->size % SECTOR != 0);
+  size_t done = 0;
+  if (offset > blocks || count > blocks - offset || count > INT_MAX ||
+      count > SIZE_MAX / SECTOR)
+    return -1;
+  for (size_t i = 0; count && i < file->count; i++) {
+    const dvd_iso9660_extent_t *extent = &file->extents[i];
+    if (offset >= extent->blocks) {
+      offset -= extent->blocks;
+      continue;
+    }
+    size_t n = extent->blocks - offset;
+    if (n > count)
+      n = count;
+    int read = InternalUDFReadBlocksRaw(ctx, extent->lba + offset, n,
+                                        data + done * SECTOR, flags);
+    if (read < 0 || (size_t)read > n)
+      return -1;
+    done += (size_t)read;
+    if ((size_t)read < n)
+      return (int)done;
+    count -= n;
+    offset = 0;
+  }
+  return count ? -1 : (int)done;
+}

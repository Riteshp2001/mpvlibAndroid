+dvdnav_title_layout_status_t dvdnav_get_title_layout(
+    dvdnav_t *self, int32_t title, dvdnav_title_layout_t **layout) {
+  dvdnav_title_layout_status_t status = DVDNAV_TITLE_LAYOUT_ERROR;
+  dvdnav_title_layout_t *result = NULL;
+  dvdnav_title_span_t *spans = NULL;
+  uint8_t *visited = NULL;
+  ifo_handle_t *ifo = NULL;
+  const title_info_t *info;
+  const ttu_t *parts;
+  uint32_t pgcn, program, max_spans;
+
+  if (!layout)
+    return status;
+  *layout = NULL;
+  if (!self || title < 1)
+    return status;
+  pthread_mutex_lock(&self->vm_lock);
+  if (!self->vm || !self->vm->vmgi || !self->vm->vmgi->tt_srpt ||
+      !self->vm->vmgi->tt_srpt->title ||
+      title > self->vm->vmgi->tt_srpt->nr_of_srpts)
+    goto done;
+  info = &self->vm->vmgi->tt_srpt->title[title - 1];
+  /* Button commands are in NAV packs, not PGC command tables. */
+  if (info->pb_ty.jlc_exists_in_button_cmd) {
+    status = DVDNAV_TITLE_LAYOUT_UNSUPPORTED;
+    goto done;
+  }
+  ifo = vm_get_title_ifo(self->vm, title);
+  if (!ifo || !ifo->vts_pgcit || !ifo->vts_pgcit->pgci_srp ||
+      !ifo->vts_ptt_srpt || !ifo->vts_ptt_srpt->title ||
+      !info->vts_ttn || info->vts_ttn > ifo->vts_ptt_srpt->nr_of_srpts)
+    goto done;
+  parts = &ifo->vts_ptt_srpt->title[info->vts_ttn - 1];
+  max_spans = ifo->vts_pgcit->nr_of_pgci_srp;
+  if (!max_spans || !parts->nr_of_ptts || !parts->ptt)
+    goto done;
+  result = calloc(1, sizeof(*result));
+  spans = calloc(max_spans, sizeof(*spans));
+  visited = calloc(max_spans, sizeof(*visited));
+  if (!result || !spans || !visited)
+    goto done;
+  result->title = (uint32_t)title;
+  result->title_set = info->title_set_nr;
+  result->spans = spans;
+  pgcn = parts->ptt[0].pgcn;
+  program = parts->ptt[0].pgn;
+  if (!pgcn)
+    goto done;
+  while (pgcn) {
+    const pgci_srp_t *srp;
+    const pgc_t *pgc;
+    uint64_t start, end, duration;
+    dvdnav_title_span_t *span;
+    if (pgcn > max_spans) {
+      status = DVDNAV_TITLE_LAYOUT_ERROR;
+      goto done;
+    }
+    if (visited[pgcn - 1]) {
+      status = DVDNAV_TITLE_LAYOUT_UNSUPPORTED;
+      goto done;
+    }
+    visited[pgcn - 1] = 1;
+    srp = &ifo->vts_pgcit->pgci_srp[pgcn - 1];
+    if (srp->block_type || srp->block_mode) {
+      status = DVDNAV_TITLE_LAYOUT_UNSUPPORTED;
+      goto done;
+    }
+    pgc = srp->pgc;
+    status = pgc_times(pgc, program, &start, &end);
+    if (status != DVDNAV_TITLE_LAYOUT_LINEAR)
+      goto done;
+    duration = end - start;
+    if (UINT64_MAX - result->duration < duration) {
+      status = DVDNAV_TITLE_LAYOUT_ERROR;
+      goto done;
+    }
+    span = &spans[result->span_count++];
+    span->pgcn = pgcn;
+    span->entry_program = program;
+    span->title_start = result->duration;
+    span->pgc_start = start;
+    span->duration = duration;
+    result->duration += duration;
+    pgcn = pgc->next_pgc_nr;
+    program = 1;
+  }
+  if (!result->duration) {
+    status = DVDNAV_TITLE_LAYOUT_UNSUPPORTED;
+    goto done;
+  }
+  *layout = result;
+  result = NULL;
+  spans = NULL;
+done:
+  if (ifo)
+    vm_ifo_close(ifo);
+  pthread_mutex_unlock(&self->vm_lock);
+  free(visited);
+  free(spans);
+  free(result);
+  return status;
+}
+
+void dvdnav_free_title_layout(dvdnav_title_layout_t *layout) {
+  if (layout) {
+    free((void *)layout->spans);
+    free(layout);
+  }
+}

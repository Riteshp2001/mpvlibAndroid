+/* Match the PGC-local clock: count an angle group once, at its first cell. */
+static dvdnav_title_layout_status_t pgc_times(
+    const pgc_t *pgc, uint32_t entry_program,
+    uint64_t *entry_time, uint64_t *end_time) {
+  uint64_t cell_starts[256];
+  uint64_t total = 0, angle_duration = 0;
+  uint32_t i;
+  int in_angle = 0;
+
+  if (!pgc || !pgc->nr_of_programs || !pgc->nr_of_cells ||
+      !pgc->program_map || !pgc->cell_playback ||
+      !entry_program || entry_program > pgc->nr_of_programs)
+    return DVDNAV_TITLE_LAYOUT_ERROR;
+  if (pgc->pg_playback_mode || pgc->still_time == 255 ||
+      (pgc->command_tbl && (pgc->command_tbl->nr_of_pre ||
+       pgc->command_tbl->nr_of_post || pgc->command_tbl->nr_of_cell)))
+    return DVDNAV_TITLE_LAYOUT_UNSUPPORTED;
+
+  for (i = 0; i < pgc->nr_of_cells; i++) {
+    const cell_playback_t *cell = &pgc->cell_playback[i];
+    int64_t duration = dvdnav_convert_time(&cell->playback_time);
+    if (duration < 0)
+      return DVDNAV_TITLE_LAYOUT_ERROR;
+    if (cell->cell_cmd_nr || cell->playback_mode || cell->still_time == 255)
+      return DVDNAV_TITLE_LAYOUT_UNSUPPORTED;
+    cell_starts[i] = total;
+    if (cell->block_type == BLOCK_TYPE_ANGLE_BLOCK) {
+      if (cell->block_mode == BLOCK_MODE_FIRST_CELL) {
+        if (in_angle)
+          return DVDNAV_TITLE_LAYOUT_ERROR;
+        in_angle = 1;
+        angle_duration = (uint64_t)duration;
+      } else {
+        if (!in_angle || (cell->block_mode != BLOCK_MODE_IN_BLOCK &&
+                          cell->block_mode != BLOCK_MODE_LAST_CELL))
+          return DVDNAV_TITLE_LAYOUT_ERROR;
+        if ((uint64_t)duration != angle_duration)
+          return DVDNAV_TITLE_LAYOUT_UNSUPPORTED;
+        if (cell->block_mode == BLOCK_MODE_LAST_CELL)
+          in_angle = 0;
+        continue;
+      }
+    } else if (cell->block_type || cell->block_mode || in_angle) {
+      return DVDNAV_TITLE_LAYOUT_ERROR;
+    }
+    if (UINT64_MAX - total < (uint64_t)duration)
+      return DVDNAV_TITLE_LAYOUT_ERROR;
+    total += (uint64_t)duration;
+  }
+  if (in_angle)
+    return DVDNAV_TITLE_LAYOUT_ERROR;
+  for (i = 0; i < pgc->nr_of_programs; i++) {
+    uint32_t cellnr = pgc->program_map[i];
+    const cell_playback_t *cell;
+    if (!cellnr || cellnr > pgc->nr_of_cells ||
+        (i && cellnr <= pgc->program_map[i - 1]))
+      return DVDNAV_TITLE_LAYOUT_ERROR;
+    cell = &pgc->cell_playback[cellnr - 1];
+    if (cell->block_type == BLOCK_TYPE_ANGLE_BLOCK &&
+        cell->block_mode != BLOCK_MODE_FIRST_CELL)
+      return DVDNAV_TITLE_LAYOUT_UNSUPPORTED;
+  }
+  *entry_time = cell_starts[pgc->program_map[entry_program - 1] - 1];
+  *end_time = total;
+  return DVDNAV_TITLE_LAYOUT_LINEAR;
+}

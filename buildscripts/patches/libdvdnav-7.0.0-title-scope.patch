+/* Caller holds vm_lock. A non-NULL layout selects title-global coordinates;
+ * otherwise only PTT entries in pgcn are returned with PGC-local coordinates. */
+static dvdnav_status_t describe_chapters(
+    dvdnav_t *self, uint32_t title, uint32_t title_set, uint32_t pgcn,
+    const dvdnav_title_layout_t *layout, uint32_t angle,
+    dvdnav_chapter_t **chapters, uint32_t *count) {
+  dvdnav_status_t status = DVDNAV_STATUS_ERR;
+  const title_info_t *info;
+  const ttu_t *parts;
+  ifo_handle_t *ifo = NULL;
+  dvdnav_chapter_t *entries = NULL;
+  uint32_t i, size = 0;
+  if (!self->vm || !self->vm->vmgi || !self->vm->vmgi->tt_srpt ||
+      !self->vm->vmgi->tt_srpt->title || !title ||
+      title > self->vm->vmgi->tt_srpt->nr_of_srpts)
+    goto done;
+  info = &self->vm->vmgi->tt_srpt->title[title - 1];
+  if (info->title_set_nr != title_set)
+    goto done;
+  ifo = vm_get_title_ifo(self->vm, (int)title);
+  if (!ifo || !ifo->vts_pgcit || !ifo->vts_pgcit->pgci_srp ||
+      !ifo->vts_ptt_srpt || !ifo->vts_ptt_srpt->title ||
+      !info->vts_ttn || info->vts_ttn > ifo->vts_ptt_srpt->nr_of_srpts)
+    goto done;
+  parts = &ifo->vts_ptt_srpt->title[info->vts_ttn - 1];
+  if (parts->nr_of_ptts && !parts->ptt)
+    goto done;
+  if (parts->nr_of_ptts) {
+    entries = calloc(parts->nr_of_ptts, sizeof(*entries));
+    if (!entries)
+      goto done;
+  }
+  for (i = 0; i < parts->nr_of_ptts; i++) {
+    const ptt_info_t *part = &parts->ptt[i];
+    const pgc_t *pgc;
+    uint32_t cell;
+    uint64_t time;
+    if (!layout && part->pgcn != pgcn)
+      continue;
+    if (!part->pgcn || part->pgcn > ifo->vts_pgcit->nr_of_pgci_srp)
+      goto done;
+    pgc = ifo->vts_pgcit->pgci_srp[part->pgcn - 1].pgc;
+    if (!pgc || !pgc->program_map || !pgc->cell_playback ||
+        !part->pgn || part->pgn > pgc->nr_of_programs)
+      goto done;
+    cell = pgc->program_map[part->pgn - 1];
+    if (!cell || cell > pgc->nr_of_cells)
+      goto done;
+    /* A program's coordinate is the start of its angle group. */
+    while (cell > 1 &&
+           pgc->cell_playback[cell - 1].block_type == BLOCK_TYPE_ANGLE_BLOCK &&
+           pgc->cell_playback[cell - 1].block_mode != BLOCK_MODE_FIRST_CELL)
+      cell--;
+    if (dvdnav_pgc_selected_angle_time(pgc, (int)angle, cell - 1, &time) != DVDNAV_STATUS_OK)
+      goto done;
+    if (layout && dvdnav_title_layout_position(
+            layout, title, part->pgcn, time, &time) != DVDNAV_STATUS_OK)
+      continue;
+    entries[size].chapter = i + 1;
+    entries[size++].time = time;
+  }
+  *chapters = entries;
+  *count = size;
+  entries = NULL;
+  status = DVDNAV_STATUS_OK;
+done:
+  if (ifo)
+    vm_ifo_close(ifo);
+  free(entries);
+  return status;
+}
+
+dvdnav_status_t dvdnav_get_current_pgc_chapters(
+    dvdnav_t *self, const dvdnav_title_position_t *expected,
+    dvdnav_chapter_t **chapters, uint32_t *count) {
+  dvdnav_status_t status = DVDNAV_STATUS_ERR;
+  if (!chapters || !count)
+    return status;
+  *chapters = NULL;
+  *count = 0;
+  if (!self || !expected)
+    return status;
+  pthread_mutex_lock(&self->vm_lock);
+  if (matches_title_angle(self, expected))
+    status = describe_chapters(self, expected->title, expected->title_set,
+                              expected->pgcn, NULL, expected->angle, chapters, count);
+  pthread_mutex_unlock(&self->vm_lock);
+  return status;
+}
+
+dvdnav_status_t dvdnav_get_title_chapters(
+    dvdnav_t *self, const dvdnav_title_layout_t *layout,
+    dvdnav_chapter_t **chapters, uint32_t *count) {
+  dvdnav_status_t status = DVDNAV_STATUS_ERR;
+  if (!chapters || !count)
+    return status;
+  *chapters = NULL;
+  *count = 0;
+  if (!self || !layout)
+    return status;
+  pthread_mutex_lock(&self->vm_lock);
+  status = describe_chapters(self, layout->title, layout->title_set, 0,
+                            layout, 1, chapters, count);
+  pthread_mutex_unlock(&self->vm_lock);
+  return status;
+}
+
+void dvdnav_free_chapters(dvdnav_chapter_t *chapters) {
+  free(chapters);
+}
+
+dvdnav_status_t dvdnav_title_layout_position(
+    const dvdnav_title_layout_t *layout, uint32_t title, uint32_t pgcn,
+    uint64_t pgc_time, uint64_t *title_time) {
+  uint32_t i;
+  if (!layout || !title_time || layout->title != title)
+    return DVDNAV_STATUS_ERR;
+  for (i = 0; i < layout->span_count; i++) {
+    const dvdnav_title_span_t *span = &layout->spans[i];
+    if (span->pgcn == pgcn) {
+      if (pgc_time < span->pgc_start ||
+          pgc_time - span->pgc_start > span->duration)
+        return DVDNAV_STATUS_ERR;
+      *title_time = span->title_start + pgc_time - span->pgc_start;
+      return DVDNAV_STATUS_OK;
+    }
+  }
+  return DVDNAV_STATUS_ERR;
+}
+
+dvdnav_status_t dvdnav_title_layout_seek(
+    const dvdnav_title_layout_t *layout, uint64_t title_time,
+    uint32_t *span_index, uint64_t *pgc_time) {
+  uint32_t i;
+  if (!layout || !span_index || !pgc_time || title_time >= layout->duration)
+    return DVDNAV_STATUS_ERR;
+  for (i = 0; i < layout->span_count; i++) {
+    const dvdnav_title_span_t *span = &layout->spans[i];
+    if (title_time >= span->title_start &&
+        title_time - span->title_start < span->duration) {

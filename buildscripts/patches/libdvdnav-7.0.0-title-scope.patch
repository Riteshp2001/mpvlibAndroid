+dvdnav_status_t dvdnav_get_current_title_position(
+    dvdnav_t *self, dvdnav_title_position_t *position) {
+  dvdnav_status_t status = DVDNAV_STATUS_ERR;
+  dvdnav_title_position_t result;
+  const dvd_state_t *state;
+  uint64_t start;
+  int title;
+  if (!self || !position)
+    return status;
+  pthread_mutex_lock(&self->vm_lock);
+  if (!self->started || !self->vm || !self->vm->vmgi ||
+      !self->vm->vmgi->tt_srpt || !self->vm->vmgi->tt_srpt->title)
+    goto done;
+  state = &self->vm->state;
+  if (state->domain != DVD_DOMAIN_VTSTitle || !state->pgc ||
+      state->vtsN < 1 || state->vtsN > UINT16_MAX ||
+      state->pgcN < 1 || state->pgcN > UINT16_MAX || state->pgN < 1 ||
+      !self->vm->vtsi || !self->vm->vtsi->vts_pgcit ||
+      state->pgcN > self->vm->vtsi->vts_pgcit->nr_of_pgci_srp ||
+      state->pgN > state->pgc->nr_of_programs || state->cellN < 1 ||
+      state->cellN > state->pgc->nr_of_cells ||
+      state->AGL_REG < 1 || state->AGL_REG > 9 ||
+      dvdnav_pgc_selected_angle_time(state->pgc, state->AGL_REG,
+          state->pgc->nr_of_cells, &result.pgc_duration) != DVDNAV_STATUS_OK ||
+      dvdnav_pgc_selected_angle_time(state->pgc, state->AGL_REG,
+          state->cellN - 1, &start) != DVDNAV_STATUS_OK)
+    goto done;
+  if (self->cur_cell_time < 0 ||
+      UINT64_MAX - start < (uint64_t)self->cur_cell_time)
+    goto done;
+  title = get_TT(self->vm, state->vtsN, state->VTS_TTN_REG);
+  if (title < 1 || title > UINT16_MAX)
+    goto done;
+  result.title = (uint32_t)title;
+  result.title_set = (uint32_t)state->vtsN;
+  result.pgcn = (uint32_t)state->pgcN;
+  result.program = (uint32_t)state->pgN;
+  result.angle = state->AGL_REG;
+  result.pgc_time = start + (uint64_t)self->cur_cell_time;
+  *position = result;
+  status = DVDNAV_STATUS_OK;
+done:
+  pthread_mutex_unlock(&self->vm_lock);
+  return status;
+}
+
+/* Caller holds vm_lock. The program/time fields are cursors, not identity. */
+static int matches_title_angle(
+    dvdnav_t *self, const dvdnav_title_position_t *expected) {
+  return expected && expected->title && expected->title <= UINT16_MAX &&
+      expected->title_set && expected->title_set <= UINT16_MAX &&
+      expected->pgcn && expected->pgcn <= UINT16_MAX &&
+      expected->angle >= 1 && expected->angle <= 9 &&
+      self->vm && (self->started || self->vm->stopped) && self->vm->vmgi &&
+      self->vm->vmgi->tt_srpt && self->vm->vmgi->tt_srpt->title &&
+      self->vm->state.domain == DVD_DOMAIN_VTSTitle &&
+      self->vm->state.vtsN == (int)expected->title_set &&
+      self->vm->vtsi && self->vm->vtsi->vts_pgcit &&
+      expected->pgcn <= self->vm->vtsi->vts_pgcit->nr_of_pgci_srp &&
+      self->vm->state.AGL_REG == expected->angle &&
+      get_TT(self->vm, self->vm->state.vtsN, self->vm->state.VTS_TTN_REG) ==
+          (int)expected->title;
+}
+
+dvdnav_status_t dvdnav_title_part_play(
+    dvdnav_t *self, const dvdnav_title_position_t *expected, int32_t part) {
+  dvdnav_status_t status = DVDNAV_STATUS_ERR;
+  vm_t *candidate = NULL;
+  const title_info_t *title;
+  const ttu_t *parts;
+  ptt_info_t target;
+  const pgc_t *pgc;
+  if (!self || !expected || part < 1)
+    return status;
+  pthread_mutex_lock(&self->vm_lock);
+  if (!matches_title_angle(self, expected) || !self->vm->state.pgc ||
+      !self->file || self->position_current.domain != DVD_DOMAIN_VTSTitle ||
+      self->position_current.vts != (int)expected->title_set ||
+      expected->title > self->vm->vmgi->tt_srpt->nr_of_srpts ||
+      !self->vm->vtsi->vts_ptt_srpt || !self->vm->vtsi->vts_ptt_srpt->title)
+    goto done;
+  title = &self->vm->vmgi->tt_srpt->title[expected->title - 1];
+  if (part > title->nr_of_ptts || title->vts_ttn < 1 ||
+      title->vts_ttn > self->vm->vtsi->vts_ptt_srpt->nr_of_srpts)
+    goto done;
+  parts = &self->vm->vtsi->vts_ptt_srpt->title[title->vts_ttn - 1];
+  if (!parts->ptt || part > parts->nr_of_ptts)
+    goto done;
+  target = parts->ptt[part - 1];
+  if (!target.pgcn || target.pgcn > self->vm->vtsi->vts_pgcit->nr_of_pgci_srp ||
+      !self->vm->vtsi->vts_pgcit->pgci_srp)
+    goto done;
+  pgc = self->vm->vtsi->vts_pgcit->pgci_srp[target.pgcn - 1].pgc;
+  if (!pgc || !target.pgn || target.pgn > pgc->nr_of_programs)
+    goto done;
+  candidate = vm_new_copy(self->vm);
+  if (!candidate)
+    goto done;
+  /* Retained presentation ownership survives read-ahead STOP. Do not restart
+   * the live VM or execute First Play; use the ordinary PTT entry semantics. */
+  candidate->stopped = 0;
+  if (!vm_jump_title_part(candidate, (int)expected->title, part))
+    goto done;
+  candidate->hop_channel++;
+  vm_merge(self->vm, candidate);
+  self->started = 1;
+  self->position_current.still = 0;
+  self->cur_cell_time = 0;
+  status = DVDNAV_STATUS_OK;
+done:
+  if (candidate)
+    vm_free_copy(candidate);
+  pthread_mutex_unlock(&self->vm_lock);
+  return status;
+}
+
+dvdnav_status_t dvdnav_pgc_time_search_floor(
+    dvdnav_t *self, const dvdnav_title_position_t *expected, uint64_t pgc_time) {
+  dvdnav_status_t status = DVDNAV_STATUS_ERR;
+  dvdnav_t probe;
+  vm_t *candidate = NULL;
+  if (!self || !expected)
+    return status;
+  pthread_mutex_lock(&self->vm_lock);
+  if (!matches_title_angle(self, expected))
+    goto done;
+  /* Prefetch can advance the live VM beyond the presented PGC. The caller's
+   * epoch owns that presentation scope; enter it only on an isolated candidate.
+   * A command that redirects entry must not silently seek another PGC. */
+  if (!self->started || self->vm->stopped ||
+      self->vm->state.pgcN != (int)expected->pgcn) {
+    candidate = vm_new_copy(self->vm);
+    if (!candidate)
+      goto done;
+    /* A read-ahead STOP exhausts the reader, not the caller's presentation
+     * scope. Resume only this candidate until the NAV landing is proven. */
+    candidate->stopped = 0;
+    if (!vm_jump_title_program(candidate, (int)expected->title,
+                               (int)expected->pgcn, 1) ||
+        candidate->stopped || candidate->state.domain != DVD_DOMAIN_VTSTitle ||
+        candidate->state.vtsN != (int)expected->title_set ||
+        candidate->state.pgcN != (int)expected->pgcn ||
+        candidate->state.AGL_REG != expected->angle ||
+        get_TT(candidate, candidate->state.vtsN, candidate->state.VTS_TTN_REG) !=
+            (int)expected->title)
+      goto done;
+  }
+  /* The floor seeker owns its transaction even when the live VM is borrowed. */
+  memset(&probe, 0, sizeof(probe));
+  probe.vm = candidate ? candidate : self->vm;
+  probe.file = self->file;
+  probe.priv = self->priv;
+  probe.logcb = self->logcb;
+  probe.started = 1;
+  probe.pgc_based = self->pgc_based;
+  probe.position_current = self->position_current;
+  pthread_mutex_init(&probe.vm_lock, NULL);
+  status = dvdnav_time_search_floor_selected_angle(&probe, pgc_time);
+  pthread_mutex_destroy(&probe.vm_lock);
+  if (status == DVDNAV_STATUS_OK) {
+    if (candidate)
+      vm_merge(self->vm, candidate);
+    self->started = 1;
+    self->cur_cell_time = probe.cur_cell_time;
+    self->verified_seek_hop = probe.verified_seek_hop;
+    self->verified_seek_angle = probe.verified_seek_angle;
+  } else {
+    memcpy(self->err_str, probe.err_str, sizeof(self->err_str));
+  }
+done:
+  if (candidate)
+    vm_free_copy(candidate);
+  pthread_mutex_unlock(&self->vm_lock);
+  return status;
+}

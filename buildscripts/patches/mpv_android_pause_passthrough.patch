+// Pause without flushing. reset() would discard the queued audio, so the
+// audio clock would jump ahead on resume and video frames would be dropped.
+static bool pull_set_pause(struct ao *ao, bool paused)
+{
+    struct priv *p = ao->priv;
+    if (!paused) {
+        start(ao);
+        return true;
+    }
+    if (!p->audiotrack)
+        return false;
+
+    JNIEnv *env = MP_JNI_GET_ENV(ao);
+    mp_mutex_lock(&p->lock);
+    MP_JNI_CALL_VOID(p->audiotrack, AudioTrack.pause);
+    MP_JNI_EXCEPTION_LOG(ao);
+    invalidate_timestamp(p);
+    mp_mutex_unlock(&p->lock);
+    return true;
+}

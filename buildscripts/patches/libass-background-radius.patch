+void ass_set_background_radius(ASS_Renderer *priv, double radius)
+{
+    radius = FFMAX(radius, 0);
+    if (priv->settings.background_radius != radius) {
+        priv->settings.background_radius = radius;
+        ass_reconfigure(priv);
+    }
+}

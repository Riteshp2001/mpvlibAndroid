+// Fill a w x h box mask, with corners rounded to radius r and anti-aliased
+// over one pixel.
+static void fill_background_mask(uint8_t *buf, int w, int h, double r)
+{
+    memset(buf, 0xFF, (size_t) w * h);
+    r = FFMIN(r, FFMIN(w, h) / 2.0);
+    int n = (int) ceil(r);
+    for (int y = 0; y < n; y++) {
+        double dy = FFMAX(r - (y + 0.5), 0);
+        uint8_t *top = buf + (size_t) y * w;
+        uint8_t *bottom = buf + (size_t) (h - 1 - y) * w;
+        for (int x = 0; x < n; x++) {
+            double dx = FFMAX(r - (x + 0.5), 0);
+            double cover = FFMINMAX(r + 0.5 - sqrt(dx * dx + dy * dy), 0, 1);
+            uint8_t a = lround(cover * 255);
+            top[x] = top[w - 1 - x] = a;
+            bottom[x] = bottom[w - 1 - x] = a;
+        }
+    }
+}

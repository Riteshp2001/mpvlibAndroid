diff --git a/player/video.c b/player/video.c
index dd5566c..16e4904 100644
--- a/player/video.c
+++ b/player/video.c
@@ -528,6 +528,14 @@ static bool reinit_video_chain_internal(struct MPContext *mpctx,
         mpctx->mouse_cursor_visible = true;
     }
 
+    // mediacodec_embed is also used for ordinary HEVC/HDR10 base-layer output.
+    // Its driver capability alone must not make FFmpeg request a Dolby Vision
+    // MediaCodec decoder. Enable the native sink only for an active Direct
+    // Dolby Vision session, and clear it again when Direct output falls back.
+    mpctx->video_out->native_dovi_sink =
+        use_dovi_direct &&
+        (mpctx->video_out->driver->caps & VO_CAP_NATIVE_DOVI);
+
     update_window_title(mpctx, true);
 
     struct vo_chain *vo_c = talloc_zero(NULL, struct vo_chain);

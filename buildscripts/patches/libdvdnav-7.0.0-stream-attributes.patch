--- a/src/dvdnav.c
+++ b/src/dvdnav.c
@@ -1649,6 +1649,22 @@
     return -1;
   }
   return (int8_t)count;
+}
+
+int8_t dvdnav_get_number_of_stream_attributes(dvdnav_t *this,
+                                                dvdnav_stream_type_t stream_type) {
+  if (stream_type != DVD_AUDIO_STREAM && stream_type != DVD_SUBTITLE_STREAM) {
+    printerr("Invalid provided stream type");
+    return -1;
+  }
+  if (!this->started) {
+    printerr("Virtual DVD machine not started.");
+    return -1;
+  }
+  pthread_mutex_lock(&this->vm_lock);
+  int8_t count = get_number_of_stream_attributes(this, stream_type);
+  pthread_mutex_unlock(&this->vm_lock);
+  return count;
 }
 

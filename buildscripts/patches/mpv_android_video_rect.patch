index c90a55cc4c..80e1c0df72 100644
--- a/video/out/vo.c
+++ b/video/out/vo.c
@@ -141,6 +141,7 @@ struct vo_internal {
     bool wakeup_on_done;
     int queued_events;              // event mask for the user
     int internal_events;            // event mask for us
+    struct vo_android_video_rect android_video_rect;
 
     double nominal_vsync_interval;
 
@@ -1328,6 +1329,32 @@ void vo_get_src_dst_rects(struct vo *vo, struct mp_rect *out_src,
                          out_src, out_dst, out_osd);
 }
 
+void vo_android_publish_video_rect(struct vo *vo,
+                                   const struct vo_android_video_rect *rect)
+{
+    struct vo_internal *in = vo->in;
+    struct vo_android_video_rect next = {0};
+    if (rect && rect->w > 0 && rect->h > 0)
+        next = *rect;
+    mp_mutex_lock(&in->lock);
+    struct vo_android_video_rect *cur = &in->android_video_rect;
+    bool changed = cur->w != next.w || cur->h != next.h ||
+                   !mp_rect_equals(&cur->rect, &next.rect);
+    *cur = next;
+    mp_mutex_unlock(&in->lock);
+    if (changed)
+        vo_event(vo, VO_EVENT_WIN_STATE);
+}
+
+bool vo_get_android_video_rect(struct vo *vo, struct vo_android_video_rect *out)
+{
+    struct vo_internal *in = vo->in;
+    mp_mutex_lock(&in->lock);
+    *out = in->android_video_rect;
+    mp_mutex_unlock(&in->lock);
+    return out->w > 0 && out->h > 0;
+}

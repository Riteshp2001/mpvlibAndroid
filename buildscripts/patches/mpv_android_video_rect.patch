+#include <math.h>
+
 #include <libavcodec/mediacodec.h>
 #include <libavutil/hwcontext.h>
 #include <libavutil/hwcontext_mediacodec.h>
 
 #include "common/common.h"
+#include "aspect.h"
+#include "sub/osd.h"
 #include "vo.h"
 #include "video/mp_image.h"
 #include "video/hwdec.h"
@@ -27,8 +31,50 @@
 struct priv {
     struct mp_image *next_image;
     struct mp_hwdec_ctx hwctx;
+    bool rect_valid; // configured for real video, not a force-window placeholder
 };
 
+static int rect_coord(double v)
+{
+    return lrint(MPCLAMP(v, -1e9, 1e9));
+}
+
+// MediaCodec scales every buffer to the whole Surface, so mpv's aspect, crop,
+// zoom and pan only apply once the host fits the Surface to this rect.
+static void publish_video_rect(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    struct mp_image_params *params = vo->params;
+    // android-surface-size must describe the whole player, not the moved Surface.
+    int w = vo->opts->android_surface_size.w;
+    int h = vo->opts->android_surface_size.h;
+    if (!p->rect_valid || !params || w <= 0 || h <= 0)
+        return;
+
+    struct mp_rect src, dst;
+    struct mp_osd_res osd;
+    mp_get_src_dst_rects(vo->log, vo->opts, vo->driver->caps, params, w, h,
+                         vo->monitor_par, &src, &dst, &osd);
+    // The OSD margins are not clipped to the viewport, so they still locate
+    // the displayed picture when it is zoomed or panned past the edges.
+    struct mp_rect crop = {0, 0, params->w, params->h};
+    if (mp_image_crop_valid(params))
+        crop = params->crop;
+    double sx = (double)(w - osd.ml - osd.mr) / mp_rect_w(crop);
+    double sy = (double)(h - osd.mt - osd.mb) / mp_rect_h(crop);
+    struct vo_android_video_rect out = {
+        .w = w,
+        .h = h,
+        .rect = {
+            .x0 = rect_coord(osd.ml - crop.x0 * sx),
+            .y0 = rect_coord(osd.mt - crop.y0 * sy),
+            .x1 = rect_coord(osd.ml + (params->w - crop.x0) * sx),
+            .y1 = rect_coord(osd.mt + (params->h - crop.y0) * sy),
+        },
+    };
+    vo_android_publish_video_rect(vo, &out);
+}
+
 static AVBufferRef *create_mediacodec_device_ref(struct vo *vo)
 {
     AVBufferRef *device_ref = av_hwdevice_ctx_alloc(AV_HWDEVICE_TYPE_MEDIACODEC);
@@ -96,11 +142,21 @@ static int query_format(struct vo *vo, int format)
 
 static int control(struct vo *vo, uint32_t request, void *data)
 {
+    switch (request) {
+    case VOCTRL_SET_PANSCAN:
+    case VOCTRL_EXTERNAL_RESIZE:
+        publish_video_rect(vo);
+        return VO_TRUE;
+    }
     return VO_NOTIMPL;
 }
 
 static int reconfig(struct vo *vo, struct mp_image_params *params)
 {
+    struct priv *p = vo->priv;
+    // A placeholder keeps the last rect, which still frames the held frame.
+    p->rect_valid = !params->force_window;
+    publish_video_rect(vo);
     return 0;
 }
 

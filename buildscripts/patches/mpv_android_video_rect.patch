+// "w:h:left:top:right:bottom": the Surface placement a vo_mediacodec_embed host
+// needs, as the decoder cannot scale or letterbox its own output.
+static int mp_property_android_video_rect(void *ctx, struct m_property *prop,
+                                          int action, void *arg)
+{
+    MPContext *mpctx = ctx;
+    struct vo_android_video_rect r;
+    if (!mpctx->video_out || !vo_get_android_video_rect(mpctx->video_out, &r))
+        return M_PROPERTY_UNAVAILABLE;
+    char s[96];
+    snprintf(s, sizeof(s), "%d:%d:%d:%d:%d:%d", r.w, r.h,
+             r.rect.x0, r.rect.y0, r.rect.x1, r.rect.y1);
+    return m_property_strdup_ro(action, arg, s);
+}

+// Where an Android host must place a video Surface that receives decoder
+// buffers unscaled (vo_mediacodec_embed), in pixels of a w*h viewport. The rect
+// covers the whole decoded frame and may extend past the viewport.
+struct vo_android_video_rect {
+    int w, h;
+    struct mp_rect rect;
+};
+
+// VO thread only. NULL withdraws the rect.
+void vo_android_publish_video_rect(struct vo *vo,
+                                   const struct vo_android_video_rect *rect);
+bool vo_get_android_video_rect(struct vo *vo, struct vo_android_video_rect *out);

+static int rect_coord(double v)
+{
+    return lrint(MPCLAMP(v, -1e9, 1e9));
+}
+
+// MediaCodec scales every buffer to the whole Surface, so mpv's aspect, crop,
+// zoom and pan only apply once the host fits the Surface to this rect.
+static void publish_video_rect(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    struct mp_image_params *params = vo->params;
+    if (!p->rect_valid || !params)
+        return;
+    // android-video-surface-transform: the host already lays the Surface out.
+    if (android_osd_overlay_transforms_video(p->osd_overlay)) {
+        vo_android_publish_video_rect(vo, NULL);
+        return;
+    }
+    // Subtitles are placed on the full-size OSD Surface; share its viewport.
+    int w = 0, h = 0;
+    if (!android_osd_overlay_get_size(p->osd_overlay, &w, &h) || w <= 0 || h <= 0)
+        return;
+
+    struct mp_rect src, dst;
+    struct mp_osd_res osd;
+    mp_get_src_dst_rects(vo->log, vo->opts, vo->driver->caps, params, w, h,
+                         vo->monitor_par, &src, &dst, &osd);
+    // The OSD margins are not clipped to the viewport, so they still locate
+    // the displayed picture when it is zoomed or panned past the edges.
+    struct mp_rect crop = {0, 0, params->w, params->h};
+    if (mp_image_crop_valid(params))
+        crop = params->crop;
+    double sx = (double)(w - osd.ml - osd.mr) / mp_rect_w(crop);
+    double sy = (double)(h - osd.mt - osd.mb) / mp_rect_h(crop);
+    struct vo_android_video_rect out = {
+        .w = w,
+        .h = h,
+        .rect = {
+            .x0 = rect_coord(osd.ml - crop.x0 * sx),
+            .y0 = rect_coord(osd.mt - crop.y0 * sy),
+            .x1 = rect_coord(osd.ml + (params->w - crop.x0) * sx),
+            .y1 = rect_coord(osd.mt + (params->h - crop.y0) * sy),
+        },
+    };
+    vo_android_publish_video_rect(vo, &out);
+}
